# ── LLM for summaries ──────────────────────────────────────────────
# none        = zero keys; extractive summaries (lead sentences)  ← default
# claude-code = uses your Claude Max subscription via the `claude` CLI you already
#               installed — no API key. Run `claude` once on the box to log in,
#               then set this. Draws from YOUR personal plan limits.
# ollama      = free local LLM (curl -fsSL https://ollama.com/install.sh | sh
#               && ollama pull llama3.2). Needs ~8GB RAM.
# openai      = cheapest paid API (gpt-4o-mini)
# anthropic   = Claude Haiku via API
LLM_PROVIDER=none

CLAUDE_CODE_BIN=claude         # under systemd use the absolute path, e.g. /home/ubuntu/.local/bin/claude
CLAUDE_CODE_MODEL=haiku        # cheapest Claude tier — do not remove this line

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano      # OpenAI's cheapest ($0.10/M in); fallback: gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest   # ultra-budget option: claude-3-haiku-20240307
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2          # 3B model; on tiny instances use llama3.2:1b

# ── Firecrawl cloud (optional; free tier at firecrawl.dev) ─────────
FIRECRAWL_API_KEY=

# ── RSS engine (keyless) ───────────────────────────────────────────
# Optional comma-separated feed URLs to replace the built-in trade press list
# (Blooloop, InPark, Attractions Magazine, Coaster101, Park World, Amusement Today)
RSS_FEEDS=

# ── Tuning (cost levers) ───────────────────────────────────────────
MAX_CONCURRENT_AGENTS=4
ARTICLES_PER_TOPIC=5           # fewer articles = fewer LLM calls
MAX_CONTENT_CHARS=4000         # article text sent per summary (~1k tokens)
BROWSER_AGENT_MAX_STEPS=25

# ── Server ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
